DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sorteador_convenios
DB_USER=root
DB_PASS=
DB_ENABLED=true

# Rota de carro: chave do Google Maps (Distance Matrix API). Vazio = OpenStreetMap.
GOOGLE_MAPS_API_KEY=

# --- Railway ---------------------------------------------------------------
# No painel do Railway (serviço da app), use as variáveis do plugin MySQL:
#
#   DB_ENABLED=true
#   DB_HOST=${{MySQL.MYSQLHOST}}
#   DB_PORT=${{MySQL.MYSQLPORT}}
#   DB_NAME=${{MySQL.MYSQLDATABASE}}
#   DB_USER=${{MySQL.MYSQLUSER}}
#   DB_PASS=${{MySQL.MYSQLPASSWORD}}
#
# Alternativa (uma linha só):
#   DB_ENABLED=true
#   MYSQL_URL=${{MySQL.MYSQL_URL}}
